        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "perfsync_retries_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Caller concurrency",
      "type": "timeseries",
      "datasource": {
        "uid": "perfsync-prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "perfsync_invocations_inflight",
