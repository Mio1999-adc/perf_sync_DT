{
  "uid": "perfsync-phase3",
  "title": "PerfSync Phase 3 \u2014 measured execution",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Verified synchronization duration (seconds)",
      "type": "timeseries",
      "datasource": {
        "uid": "perfsync-prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(perfsync_sync_seconds_sum[1m]) / rate(perfsync_sync_seconds_count[1m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Invocations",
      "type": "timeseries",
      "datasource": {
        "uid": "perfsync-prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "perfsync_invocations_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Invocation failures",
      "type": "timeseries",
      "datasource": {
        "uid": "perfsync-prometheus",
        "type": "prometheus"
      },
